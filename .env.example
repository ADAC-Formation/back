# Base de données
DB_URL=jdbc:postgresql://localhost:5432/adac_portail
DB_USERNAME=adac_user
DB_PASSWORD=adac_password

# JWT
# Générer avec : openssl rand -base64 48
JWT_SECRET=your_secret_key_min_256_bits
JWT_EXPIRATION=86400000
# Pas de JWT_COOKIE_SECURE ici : forcé à true en prod (application-prod.yml, non surchargeable
# par .env) et à false en dev (application.yml) — voir TICKET-006.

# Email (dev — Mailtrap)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
# Sender address for activation/reset emails — deliberately NOT the same as MAIL_USERNAME (that's
# the SMTP login, e.g. a Mailtrap token, not necessarily an accepted sender identity). Optional
# here (defaults to no-reply@adac.fr in application.yml); set explicitly in prod for Brevo.
MAIL_FROM=no-reply@adac.fr

# Email (prod — Brevo)
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=your_brevo_login
# MAIL_PASSWORD=your_brevo_smtp_key

# Supabase Storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_service_role_key
SUPABASE_BUCKET=adac-documents

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://portail.adac.asso.fr

# Spring
SPRING_PROFILES_ACTIVE=dev

# Docker Compose uniquement — image frontend à pull, publiée par le CI du repo front (TICKET-041).
# Tag provisoire (ex: "dev") tant qu'aucune image réelle n'est publiée — voir TICKET-010/011.
FRONT_IMAGE_TAG=latest
